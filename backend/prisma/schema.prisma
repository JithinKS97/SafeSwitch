generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Better Auth tables
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model Position {
  id           String         @id @default(uuid())
  userId       String
  pair         String
  direction    TradeDirection
  riskAppetite RiskAppetite
  amount       Float          @default(0)
  status       PositionStatus @default(INACTIVE)
  mode         TradingMode    @default(PAPER)
  confidence   Float          @default(0)
  pnl          Float          @default(0)
  entryPrice   Float?
  currentPrice Float?
  liveQuantity Float?   // Base asset quantity held (LIVE mode only)
  closeReason  CloseReason?
  agentOpened  Boolean        @default(false)
  instruction  String         @default("")  // Per-pair instruction for the agent
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  activatedAt  DateTime?
  closedAt     DateTime?

  trades       Trade[]

  @@map("positions")
}

model AgentJournal {
  id        String   @id @default(uuid())
  userId    String
  cycleNum  Int
  entry     String
  decisions Json
  createdAt DateTime @default(now())

  @@map("agent_journal")
}

model PairJournal {
  id                 String   @id @default(uuid())
  userId             String
  pair               String
  confidence         Float    @default(0)
  summarisedKnowledge String @default("")
  updatedAt          DateTime @updatedAt

  entries PairJournalEntry[]

  @@unique([userId, pair])
  @@map("pair_journals")
}

model PairJournalEntry {
  id            String   @id @default(uuid())
  pairJournalId String
  cycleNum      Int
  action        String   // "ENTER" | "EXIT"
  reasoning     String
  outcome       Json?    // { pnl, closeReason } when EXIT
  createdAt     DateTime @default(now())

  pairJournal PairJournal @relation(fields: [pairJournalId], references: [id], onDelete: Cascade)

  @@map("pair_journal_entries")
}

model AgentInstruction {
  id        String   @id @default(uuid())
  userId    String   @unique
  instruction String @default("")
  updatedAt DateTime @updatedAt

  @@map("agent_instruction")
}

model UserBinanceKey {
  id               String   @id @default(uuid())
  userId           String   @unique
  apiKey           String   // Stored for signing; never returned to client
  apiSecretEncrypted String // Encrypted at rest
  apiKeyMasked     String   // Last 4 chars for display, e.g. "...xyz1"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("user_binance_keys")
}

model SuggestionSnapshot {
  id          String   @id @default(uuid())
  userId      String
  riskPct     Int
  analysis    String
  suggestions Json
  createdAt   DateTime @default(now())

  @@map("suggestion_snapshots")
}

model Trade {
  id         String      @id @default(uuid())
  positionId String
  side       TradeSide
  quantity   Float
  price      Float
  mode       TradingMode
  pnl        Float?
  openedAt   DateTime    @default(now())
  closedAt   DateTime?

  position   Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@map("trades")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum RiskAppetite {
  LOW
  MEDIUM
  HIGH
}

enum TradeDirection {
  LONG
  SHORT
}

enum TradingMode {
  PAPER
  LIVE
}

enum PositionStatus {
  INACTIVE    // added, not yet trading
  ACTIVE      // paper or live trading in progress
  COMPLETED   // profit target hit, closed cleanly
  STOPPED     // manually stopped or emergency exit
}

enum TradeSide {
  BUY
  SELL
}

enum CloseReason {
  PROFIT_TARGET   // pnl target reached
  DRAWDOWN_LIMIT  // loss exceeded risk threshold
  MANUAL          // user stopped it
}
